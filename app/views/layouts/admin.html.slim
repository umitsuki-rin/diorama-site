doctype html
html lang="ja"
  head
    title = [content_for(:title), "DIORAMA 管理画面"].compact.join(" | ")
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="robots" content="noindex,nofollow"
    link rel="icon" href="/favicon.ico" sizes="any"
    = csrf_meta_tags
    = csp_meta_tag
    = render "shared/font_awesome"
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  body.min-h-screen.bg-gray-50.text-gray-800 data-controller="admin-menu"
    / スマホ用トップバー
    header.md:hidden.sticky.top-0.z-30.flex.items-center.justify-between.bg-white.border-b.border-gray-200.px-4.h-14
      = link_to "DIORAMA CMS", admin_root_path, class: "font-bold text-gray-800"
      button.p-2.text-gray-600 type="button" data-action="admin-menu#toggle" aria-label="メニューを開閉" aria-controls="admin-sidebar" aria-expanded="false" data-admin-menu-target="button"
        i.fa-solid.fa-bars.text-lg

    .flex
      aside#admin-sidebar.hidden.md:block.fixed.md:sticky.inset-x-0.top-14.md:top-0.bottom-0.md:h-screen.z-20.w-full.md:w-60.shrink-0.bg-white.border-r.border-gray-200.overflow-y-auto data-admin-menu-target="menu"
        .hidden.md:block.px-6.py-6
          = link_to "DIORAMA CMS", admin_root_path, class: "text-lg font-bold text-gray-800"
        nav.px-3.py-4.md:py-0.space-y-1
          - admin_menu_items.each do |item|
            = link_to send(item[:path]), class: admin_menu_item_class(item) do
              i.fa-solid.w-5.text-center class=item[:icon]
              span = item[:label]
        .border-t.border-gray-200.mt-6.px-3.py-4.space-y-1
          p.px-4.pb-2.text-xs.text-gray-400.truncate title=Current.user&.email_address
            | ログイン中：
            = Current.user&.email_address
          = link_to edit_admin_password_path, class: admin_menu_item_class({ controller: "admin/passwords" }) do
            i.fa-solid.fa-key.w-5.text-center
            span パスワード変更
          = link_to root_path, target: "_blank", rel: "noopener", class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm text-gray-600 hover:bg-gray-100" do
            i.fa-solid.fa-arrow-up-right-from-square.w-5.text-center
            span 公開サイトを見る
          = button_to session_path, method: :delete, class: "w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm text-gray-600 hover:bg-gray-100 cursor-pointer" do
            i.fa-solid.fa-right-from-bracket.w-5.text-center
            span ログアウト

      main.flex-1.min-w-0.px-4.py-6.md:px-10.md:py-10
        - if notice.present?
          .mb-6.bg-green-50.border.border-green-200.text-green-800.rounded-lg.px-4.py-3.text-sm role="status"
            = notice
        - if alert.present?
          .mb-6.bg-red-50.border.border-red-200.text-red-800.rounded-lg.px-4.py-3.text-sm role="alert"
            = alert
        = yield
