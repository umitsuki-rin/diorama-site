- content_for :title, "ダッシュボード"

h1.text-2xl.font-bold.text-gray-800.mb-6 ダッシュボード

- cards = [ { label: "公開中の楽曲", count: @published_songs_count, icon: "fa-music", color: "text-indigo-600 bg-indigo-50", path: admin_songs_path },
            { label: "公開中のニュース", count: @published_news_count, icon: "fa-newspaper", color: "text-green-600 bg-green-50", path: admin_news_index_path },
            { label: "下書き合計", count: @drafts_count, icon: "fa-file-pen", color: "text-gray-600 bg-gray-100", path: admin_songs_path },
            { label: "未対応のお問い合わせ", count: @unresponded_contacts_count, icon: "fa-envelope", color: "text-amber-600 bg-amber-50", path: admin_contacts_path } ]

.grid.grid-cols-1.sm:grid-cols-2.xl:grid-cols-4.gap-6
  - cards.each do |card|
    = link_to card[:path], class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex items-center gap-4 hover:border-indigo-300 transition-colors" do
      .w-12.h-12.rounded-lg.flex.items-center.justify-center class=card[:color]
        i.fa-solid.text-xl class=card[:icon]
      div
        p.text-sm.text-gray-500 = card[:label]
        p.text-3xl.font-bold.text-gray-800 = card[:count]
