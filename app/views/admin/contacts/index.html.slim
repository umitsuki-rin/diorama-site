- content_for :title, "お問い合わせ"

h1.text-2xl.font-bold.text-gray-800.mb-6 お問い合わせ

.bg-white.rounded-xl.shadow-sm.border.border-gray-200.overflow-hidden
  .overflow-x-auto
    table.w-full.text-sm
      thead
        tr.bg-gray-50
          th.px-5.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase 受信日時
          th.px-5.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase お名前
          th.px-5.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.hidden.md:table-cell 企業名
          th.px-5.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.hidden.lg:table-cell 内容
          th.px-5.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase 対応状況
          th.px-5.py-3.text-right.text-xs.font-medium.text-gray-500.uppercase 操作
      tbody
        - @contacts.each do |contact|
          tr.border-t.border-gray-100.hover:bg-gray-50.cursor-pointer class=("bg-amber-50/40" unless contact.responded?) data-controller="row-link" data-row-link-url-value=admin_contact_path(contact) data-action="click->row-link#visit"
            td.px-5.py-3.text-gray-600.whitespace-nowrap = l(contact.created_at)
            td.px-5.py-3.font-medium.text-gray-800 = contact.name
            td.px-5.py-3.text-gray-600.hidden.md:table-cell = contact.company_name.presence || "—"
            td.px-5.py-3.text-gray-600.hidden.lg:table-cell.max-w-xs.truncate = contact.body
            td.px-5.py-3 = responded_badge(contact)
            td.px-5.py-3
              .flex.items-center.justify-end.gap-4
                = link_to admin_contact_path(contact), class: "text-gray-400 hover:text-indigo-600", title: "詳細", aria: { label: "詳細" } do
                  i.fa-solid.fa-eye
                = button_to admin_contact_path(contact), method: :delete, class: "text-gray-400 hover:text-red-600 cursor-pointer", title: "削除", aria: { label: "削除" }, form: { data: { turbo_confirm: "本当に削除しますか？" } } do
                  i.fa-solid.fa-trash
        - if @contacts.empty?
          tr.border-t.border-gray-100
            td.px-5.py-10.text-center.text-gray-400 colspan="6" お問い合わせはまだありません
