- content_for :title, "お問い合わせ詳細"

.flex.flex-wrap.items-center.justify-between.gap-4.mb-6
  h1.text-2xl.font-bold.text-gray-800 お問い合わせ詳細
  = link_to admin_contacts_path, class: "inline-flex items-center gap-2 #{AdminHelper::SECONDARY_BUTTON_CLASS}" do
    i.fa-solid.fa-arrow-left
    span 一覧に戻る

.bg-white.rounded-xl.shadow-sm.border.border-gray-200.p-6.space-y-6
  .flex.flex-wrap.items-center.justify-between.gap-4
    div.flex.items-center.gap-3
      = responded_badge(@contact)
      span.text-sm.text-gray-500 = l(@contact.created_at, format: :long)
    = button_to admin_contact_path(@contact), method: :patch, class: @contact.responded? ? AdminHelper::SECONDARY_BUTTON_CLASS : AdminHelper::PRIMARY_BUTTON_CLASS do
      i.fa-solid.mr-2 class=(@contact.responded? ? "fa-rotate-left" : "fa-check")
      = @contact.responded? ? "未対応に戻す" : "対応済みにする"
  dl.grid.grid-cols-1.md:grid-cols-2.gap-6.text-sm
    div
      dt.text-gray-500.mb-1 企業名
      dd.text-gray-800 = @contact.company_name.presence || "—"
    div
      dt.text-gray-500.mb-1 お名前
      dd.text-gray-800 = @contact.name
    div.md:col-span-2
      dt.text-gray-500.mb-1 メールアドレス
      dd = mail_to @contact.email, class: "text-indigo-600 hover:underline break-all"
    div.md:col-span-2
      dt.text-gray-500.mb-1 お問い合わせ内容
      dd.text-gray-800.leading-relaxed.bg-gray-50.rounded-lg.p-4 = simple_format(@contact.body)
  .pt-4.border-t.border-gray-100
    = button_to admin_contact_path(@contact), method: :delete, class: "inline-flex items-center gap-2 text-sm text-red-600 hover:text-red-700 cursor-pointer", form: { data: { turbo_confirm: "本当に削除しますか？" } } do
      i.fa-solid.fa-trash
      span 削除する
