- content_for :title, "パスワード変更"

h1.text-2xl.font-bold.text-gray-800.mb-6 パスワード変更

- if @user.developer?
  .bg-white.rounded-xl.shadow-sm.border.border-gray-200.p-6.text-sm.text-gray-600.leading-relaxed
    p 開発者アカウント（#{@user.email_address}）のパスワードは .env の ADMIN_USER_PASS で管理しています。
    p.mt-2 変更する場合は .env を書き換えてから、サーバーを再起動してください。
- else
  = render "admin/shared/errors", record: @user

  = form_with url: admin_password_path, method: :patch, class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6 max-w-xl" do |f|
    div
      = f.label :current_password, "現在のパスワード *", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72, class: AdminHelper::INPUT_CLASS
    div
      = f.label :password, "新しいパスワード *", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :password, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72, class: AdminHelper::INPUT_CLASS
      p.mt-1.text-xs.text-gray-400 #{User::PASSWORD_MIN_LENGTH}文字以上
    div
      = f.label :password_confirmation, "新しいパスワード（確認） *", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: AdminHelper::INPUT_CLASS
    .flex.flex-wrap.gap-3
      = f.submit "変更する", class: AdminHelper::PRIMARY_BUTTON_CLASS
      = link_to "キャンセル", admin_root_path, class: AdminHelper::SECONDARY_BUTTON_CLASS
