- content_for :title, "ユーザーの追加"

h1.text-2xl.font-bold.text-gray-800.mb-6 ユーザーの追加

= render "admin/shared/errors", record: @user

= form_with model: [ :admin, @user ], class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6 max-w-xl" do |f|
  div
    = admin_label f, :email_address, required: true
    = f.email_field :email_address, required: true, autocomplete: "off", class: AdminHelper::INPUT_CLASS
  div
    = admin_label f, :password, required: true, note: "#{User::PASSWORD_MIN_LENGTH}文字以上。ログイン後に本人が変更できます"
    = f.password_field :password, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72, class: AdminHelper::INPUT_CLASS
  div
    = admin_label f, :password_confirmation, required: true
    = f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: AdminHelper::INPUT_CLASS
  .flex.flex-wrap.gap-3
    = f.submit "追加する", class: AdminHelper::PRIMARY_BUTTON_CLASS
    = link_to "キャンセル", admin_users_path, class: AdminHelper::SECONDARY_BUTTON_CLASS
