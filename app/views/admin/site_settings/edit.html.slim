- content_for :title, "サイト設定の編集"

h1.text-2xl.font-bold.text-gray-800.mb-6 サイト設定の編集

= render "admin/shared/errors", record: @site_setting

= form_with model: @site_setting, url: admin_site_setting_path, method: :patch, class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6" do |f|
  .grid.grid-cols-1.md:grid-cols-2.gap-6
    div
      = admin_label f, :logo, note: "PNG / SVG など。未登録なら既定のロゴ"
      = f.file_field :logo, accept: "image/*", class: AdminHelper::FILE_INPUT_CLASS
      - if @site_setting.logo.attached? && @site_setting.logo.persisted?
        = image_tag @site_setting.logo, class: "mt-3 max-h-32 rounded-lg border border-gray-200 bg-gray-800 p-2"
        label.mt-2.flex.items-center.gap-2.text-sm.text-gray-600
          = check_box_tag :remove_logo, "1", false, class: "rounded"
          | 登録済みのロゴを削除して既定に戻す
    div
      = admin_label f, :bgm, note: "MP3 / WAV など。未登録なら既定の音源"
      = f.file_field :bgm, accept: "audio/*", class: AdminHelper::FILE_INPUT_CLASS
      - if @site_setting.bgm.attached? && @site_setting.bgm.persisted?
        audio.mt-3.w-full controls="" preload="none" src=url_for(@site_setting.bgm)
        label.mt-2.flex.items-center.gap-2.text-sm.text-gray-600
          = check_box_tag :remove_bgm, "1", false, class: "rounded"
          | 登録済みの BGM を削除して既定に戻す
  .flex.flex-wrap.gap-3
    = f.submit "保存する", class: AdminHelper::PRIMARY_BUTTON_CLASS
    = link_to "キャンセル", admin_site_setting_path, class: AdminHelper::SECONDARY_BUTTON_CLASS
