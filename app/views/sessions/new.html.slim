- content_for :title, "ログイン"

h1.text-lg.font-bold.text-gray-800.mb-6 ログイン

= form_with url: session_path, class: "space-y-4" do |form|
  div
    = form.label :email_address, "ID（メールアドレス）", class: "block text-sm font-medium text-gray-700 mb-1"
    = form.text_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: AdminHelper::INPUT_CLASS
  div
    = form.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1"
    = form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: AdminHelper::INPUT_CLASS
  = form.submit "ログイン", class: "w-full #{AdminHelper::PRIMARY_BUTTON_CLASS}"

p.mt-4.text-center
  = link_to "パスワードを忘れた場合", new_password_path, class: "text-sm text-indigo-600 hover:underline"
