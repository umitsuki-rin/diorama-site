- content_for :title, "パスワード再設定"

h1.text-lg.font-bold.text-gray-800.mb-6 パスワード再設定

= form_with url: passwords_path, class: "space-y-4" do |form|
  div
    = form.label :email_address, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1"
    = form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: AdminHelper::INPUT_CLASS
  = form.submit "再設定メールを送信", class: "w-full #{AdminHelper::PRIMARY_BUTTON_CLASS}"

p.mt-4.text-center
  = link_to "ログイン画面に戻る", new_session_path, class: "text-sm text-indigo-600 hover:underline"
