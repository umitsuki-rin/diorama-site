ARG RUBY_VERSION=4.0.2
FROM ruby:${RUBY_VERSION}


WORKDIR /app

RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    default-mysql-client \
    git \
    less \
    vim \
    curl \
    libvips \
    && npm install -g yarn

RUN gem update --system && \
    gem install bundler && \
    gem install foreman

# エイリアス
RUN echo 'alias rails="bin/rails"' >> ~/.bashrc

CMD ["bin/dev"]